{
  "name": "docview",
  "version": "1.9.0",
  "type": "module",
  "description": "Beautiful document viewer for Markdown, YAML, JSON, CSV, config files, and images with Mermaid diagram and Marp slide support",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simota/docview"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "author": "",
  "bin": {
    "mdv": "bin/mdv.mjs",
    "docview": "bin/mdv.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "lib/",
    "server.mjs",
    "package.json",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "serve": "npm run build && node server.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test:e2e": "npx playwright test",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test:unit": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "markdown",
    "yaml",
    "json",
    "csv",
    "viewer",
    "mermaid",
    "marp",
    "slides",
    "document",
    "cli"
  ],
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/papaparse": "^5.5.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@marp-team/marp-core": "^4.4.0",
    "chokidar": "^6.0.0",
    "cron-parser": "^5.10.2",
    "cronstrue": "^3.38.0",
    "dompurify": "^3.4.17",
    "exifr": "^7.1.3",
    "highlight.js": "^11.12.0",
    "jschardet": "^4.1.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.2.0",
    "modern-screenshot": "^4.7.0",
    "papaparse": "^5.7.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "npm@12.2.1",
  "optionalDependencies": {
    "c2pa-node": "^0.5.26"
  },
  "overrides": {
    "c2pa-node": {
      "sharp": "^0.35.5",
      "brace-expansion": "^1.1.21"
    },
    "speech-rule-engine": {
      "@xmldom/xmldom": "^0.9.12"
    }
  }
}
